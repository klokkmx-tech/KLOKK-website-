---
// QR a la liga del demo, generado en build (sin JS en el cliente). Solo se
// muestra en escritorio (≥ lg): en móvil el CTA abre wa.me directo.
import QRCode from 'qrcode';
import { LINKS } from '../lib/links';

const svg = await QRCode.toString(LINKS.demoWhatsApp, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#0f3237', light: '#ffffff' },
});
---

<div
  class="qr-demo hidden items-center gap-3 rounded-2xl border border-neutral-200 bg-white py-2.5 pr-4 pl-2.5 shadow-sm lg:flex"
>
  <div
    class="size-[4.5rem] shrink-0 rounded-lg bg-white p-1"
    role="img"
    aria-label="Código QR que abre el demo de Klokk en WhatsApp"
    set:html={svg}
  />
  <p class="max-w-[8.5rem] text-[0.78rem] leading-snug text-neutral-600">
    Escanéalo con tu teléfono para abrir el demo en WhatsApp.
  </p>
</div>

<style>
  .qr-demo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    shape-rendering: crispEdges;
  }
</style>
