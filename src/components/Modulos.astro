---
const disponibles = [
  {
    title: 'Registro de asistencia',
    body: 'Entradas, salidas y turnos por WhatsApp, con folio y hora de servidor.',
  },
  {
    title: 'Geolocalización',
    body: 'Ubicación del registro y geocercas por centro de trabajo.',
  },
  {
    title: 'Evidencia certificada NOM-151',
    body: 'Cada registro se conserva con sellado de tiempo de un Prestador de Servicios de Certificación autorizado.',
  },
];
---

<section id="que-incluye" class="scroll-mt-16 border-t border-neutral-100 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Qué está funcionando hoy
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-neutral-600">
        Publicamos el estado real de cada módulo.
      </p>
    </div>

    <div class="reveal mt-12">
      <h3 class="text-[0.95rem] font-bold text-ink-900">Disponible hoy</h3>
      <ul class="mt-5 grid gap-x-10 divide-y divide-neutral-100 md:grid-cols-3 md:divide-y-0">
        {
          disponibles.map((m) => (
            <li class="flex gap-5 py-5 first:pt-0 md:flex-col md:gap-3 md:py-0">
              <span class="mt-0.5 flex h-fit w-fit shrink-0 items-center gap-1.5 rounded-md bg-brand-100 px-2 py-1 font-mono text-[0.7rem] font-medium text-brand-700">
                <span class="live-dot size-1.5 rounded-full bg-brand-600" aria-hidden="true" />
                en vivo
              </span>
              <div>
                <h4 class="font-bold text-ink-900">{m.title}</h4>
                <p class="mt-1 text-[0.9rem] leading-relaxed text-neutral-600">{m.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .live-dot {
    animation: live-breathe 2.2s ease-in-out infinite;
  }
  @keyframes live-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }
</style>
