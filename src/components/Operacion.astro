---
const casos = [
  { caption: 'Cuadrilla de obra checando al llegar al frente de trabajo.' },
  { caption: 'Personal de piso en sucursal, sin terminal ni lector de huella.' },
  { caption: 'Equipos de limpieza y servicio que rotan entre domicilios.' },
];
---

<section class="border-t border-neutral-100 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Así se ve en operación
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-neutral-600">
        Cuadrillas de obra, sucursales, personal de limpieza y servicio. Gente que no está frente
        a una computadora y que no va a instalar una app.
      </p>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-3 sm:gap-6">
      {
        casos.map((caso, i) => (
          <figure class="reveal" style={`--reveal-delay: ${i * 110}ms`}>
            <div class="grid aspect-[4/3] place-items-center rounded-2xl border border-dashed border-neutral-300 bg-neutral-50">
              <span class="font-mono text-xs text-neutral-400">imagen temporal</span>
            </div>
            <figcaption class="mt-3 text-[0.9rem] leading-relaxed text-neutral-600">
              {caso.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="reveal mt-20">
      <h3 class="text-[0.95rem] font-bold text-ink-900">
        Empresas que ya llevan su asistencia con Klokk
      </h3>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {
          Array.from({ length: 6 }).map(() => (
            <div class="grid h-14 place-items-center rounded-xl border border-dashed border-neutral-300">
              <span class="font-mono text-[0.7rem] text-neutral-400">logo cliente</span>
            </div>
          ))
        }
      </div>
      <p class="mt-3 text-[0.8rem] text-neutral-500">
        Espacio reservado. Se llena con los primeros clientes que autoricen el uso de su marca.
      </p>
    </div>
  </div>
</section>
