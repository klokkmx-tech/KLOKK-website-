# DEMO-WEB-01 · solo nombres. Los valores van en Vercel (servidor) y en .env local.
# Nunca valores de producción de Klokk. Nunca secretos con prefijo PUBLIC_.

# Supabase (proyecto exclusivo del demo)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / WhatsApp Cloud API (app, WABA y número exclusivos del demo)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_APP_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_API_VERSION=v24.0

# Crons de Vercel
CRON_SECRET=

# Agenda real a la que redirige /a/<token>
AGENDA_URL=

# Correo (Resend). El remitente debe estar en avisos.klokk.mx; la app no arranca con otro dominio.
# Ejemplos: CORREO_REMITENTE=Klokk demo <demo@avisos.klokk.mx>
#           CORREO_EQUIPO=ventas@klokk.mx, jp@klokk.mx
RESEND_API_KEY=
CORREO_REMITENTE=
CORREO_EQUIPO=

# Única variable pública: número del demo en formato internacional sin «+»
PUBLIC_WA_DEMO_NUMBER=
