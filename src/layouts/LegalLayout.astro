---
// Página legal sencilla: encabezado de marca, aviso de «provisional» y pie.
// El texto de cada página lo aporta el slot; cuando el abogado entregue el
// documento definitivo basta con reemplazar el contenido y quitar `provisional`.
import Layout from './Layout.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  provisional?: boolean;
}

const { title, description, provisional = true } = Astro.props;
---

<Layout title={`${title} — Klokk`} description={description}>
  <header class="border-b border-neutral-200 bg-white/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5 sm:px-8">
      <a href="/" aria-label="Klokk — inicio"><Logo /></a>
      <a href="/" class="text-[0.9rem] font-medium text-neutral-600 underline-offset-4 hover:text-ink-900 hover:underline">
        Volver al sitio
      </a>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    {
      provisional && (
        <p class="inline-flex items-center gap-2 rounded-full border border-amber-line/40 bg-amber-badge px-3 py-1 text-[0.78rem] font-semibold text-amber-ink">
          Provisional: pendiente de revisión legal
        </p>
      )
    }
    <h1 class="font-display mt-5 text-3xl leading-[1.1] font-bold tracking-tight sm:text-4xl">
      {title}
    </h1>
    <div class="legal-prose mt-10 space-y-8 text-[1rem] leading-relaxed text-neutral-700">
      <slot />
    </div>
  </main>

  <footer class="border-t border-neutral-200 bg-neutral-50">
    <div class="mx-auto max-w-3xl px-5 py-8 text-[0.85rem] text-neutral-500 sm:px-8">
      Klokk Technology, S. de R.L. de C.V. · Mérida, Yucatán, México.
    </div>
  </footer>
</Layout>

<style is:global>
  .legal-prose h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink-900);
    margin-bottom: 0.6rem;
  }
  .legal-prose p + p {
    margin-top: 0.75rem;
  }
  .legal-prose a {
    color: var(--color-brand-700);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
